{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true,
    "browser": true,
    "bun": true,
    "node": true
  },
  "ignorePatterns": [
    "assets/terminal/terminal.bundle.js",
    "crates/code-editor/assets/editor.bundle.js",
    "crates/code-editor/assets/lsp.bundle.js"
  ]
}
