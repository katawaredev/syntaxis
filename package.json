{
  "name": "syntaxis",
  "private": true,
  "scripts": {
    "build:browser-ai": "node scripts/build-browser-ai.mjs",
    "build:editor": "node scripts/build-code-editor.mjs",
    "build:browser-archive": "node scripts/build-browser-archive.mjs",
    "build:browser-git": "node scripts/build-browser-git.mjs",
    "build:browser-terminal": "node scripts/build-browser-terminal.mjs",
    "build:terminal": "node scripts/build-terminal.mjs",
    "bundle:report": "bun scripts/report-bundle-sizes.mjs",
    "format:web": "oxfmt --write \"*.{js,mjs,cjs,css,json,jsonc}\" \"**/*.{js,mjs,cjs,css,json,jsonc}\"",
    "format:web:check": "oxfmt --check \"*.{js,mjs,cjs,css,json,jsonc}\" \"**/*.{js,mjs,cjs,css,json,jsonc}\"",
    "generate:pi-settings": "bun scripts/generate-pi-settings.mjs",
    "lint:web": "oxlint --deny-warnings .",
    "lint:web:fix": "oxlint --fix --deny-warnings .",
    "test:terminal": "bun test crates/runtime-remote/bridge-src/terminal/source-links.test.js",
    "lighthouse": "rm -rf target/dx/syntaxis-server/release/web/public && dx build --package syntaxis-server --platform web --release --locked --debug-symbols false && lhci autorun",
    "lighthouse:open": "lhci open",
    "autoresearch:benchmark": "bun autoresearch/benchmark.mjs",
    "autoresearch:compare": "bun autoresearch/compare.mjs",
    "autoresearch:browser-smoke": "bun autoresearch/browser-smoke.mjs",
    "autoresearch:browser-smoke:dist": "BROWSER_DIST=target/dx/syntaxis-browser/debug/web/public bun autoresearch/browser-smoke.mjs",
    "autoresearch:recent-projects": "bun autoresearch/recent-projects.mjs",
    "autoresearch:test": "bun test autoresearch/*.test.js",
    "autoresearch:verify": "bun autoresearch/verify.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/lsp-client": "^6.2.5",
    "@codemirror/merge": "^6.10.0",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "6.43.8",
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "6.0.3",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "isomorphic-git": "1.41.9",
    "just-bash": "3.4.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@lhci/cli": "0.15.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "puppeteer-core": "^24.43.1"
  },
  "overrides": {
    "@codemirror/view": "6.43.8"
  }
}
