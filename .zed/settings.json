{
  "format_on_save": "on",
  "languages": {
    "Rust": {
      "formatter": [
        {
          "language_server": {
            "name": "rust-analyzer"
          }
        },
        {
          "external": {
            "command": "dx",
            "arguments": ["fmt", "--file", "-"]
          }
        }
      ]
    }
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rust": {
          "analyzerTargetDir": true
        },
        "cargo": {
          "features": ["web"],
          "allTargets": false
        },
        "check": {
          "command": "clippy",
          "workspace": true,
          "allTargets": false
        },
        "procMacro": {
          "enable": true
        },
        "inlayHints": {
          "lifetimeElisionHints": {
            "enable": "skip_trivial",
            "useParameterNames": true
          },
          "closureReturnTypeHints": {
            "enable": "with_block"
          }
        }
      }
    }
  }
}
